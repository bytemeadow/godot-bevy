{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bytemeadow/godot-bevy/native-summary-v1.schema.json",
  "title": "godot-bevy native sampling profile v1",
  "description": "Whole-process Samply CPU-sampling evidence. It includes process startup and teardown and is not benchmark-compatible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "run_id",
    "evidence_kind",
    "benchmark_compatible",
    "disclosure",
    "complete",
    "outcome",
    "generated_at",
    "environment",
    "selection",
    "scope",
    "sampling",
    "samples",
    "symbols",
    "hotspots",
    "errors",
    "artifacts",
    "metadata"
  ],
  "properties": {
    "$schema": { "const": "native-summary-v1.schema.json" },
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "evidence_kind": { "const": "native-sampling-profile" },
    "benchmark_compatible": { "const": false },
    "disclosure": { "const": "INSTRUMENTED PROFILE — NOT BENCHMARK RESULTS" },
    "complete": { "type": "boolean" },
    "outcome": { "enum": ["incomplete", "pass", "error"] },
    "generated_at": { "type": "string", "minLength": 1 },
    "environment": { "$ref": "#/$defs/environment" },
    "selection": { "$ref": "#/$defs/selection" },
    "scope": { "$ref": "#/$defs/scope" },
    "sampling": { "$ref": "#/$defs/sampling" },
    "samples": { "$ref": "#/$defs/samples" },
    "symbols": { "$ref": "#/$defs/symbols" },
    "hotspots": {
      "type": "array",
      "items": { "$ref": "#/$defs/hotspot" }
    },
    "errors": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "metadata": { "$ref": "#/$defs/metadata" }
  },
  "$defs": {
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cargo_profile",
        "git_commit",
        "git_short",
        "git_dirty",
        "os",
        "arch",
        "cpu",
        "rustc_version",
        "godot_version",
        "samply_version",
        "features"
      ],
      "properties": {
        "cargo_profile": { "const": "profiling" },
        "git_commit": { "type": "string", "minLength": 1 },
        "git_short": { "type": "string", "minLength": 1 },
        "git_dirty": { "type": "boolean" },
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 },
        "cpu": { "type": "string", "minLength": 1 },
        "rustc_version": { "type": "string", "minLength": 1 },
        "godot_version": { "type": "string", "minLength": 1 },
        "samply_version": { "const": "0.13.1" },
        "features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requested", "selected", "benchmarks"],
      "properties": {
        "mode": { "const": "exact" },
        "requested": { "type": "string", "minLength": 1 },
        "selected": { "const": 1 },
        "benchmarks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "includes_startup", "includes_teardown", "measurement_window"],
      "properties": {
        "kind": { "const": "whole-process" },
        "includes_startup": { "const": true },
        "includes_teardown": { "const": true },
        "measurement_window": { "const": "spawn-to-exit" }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profiler",
        "rate_hz",
        "reuse_threads",
        "minimum_workload_seconds",
        "observed_wall_seconds",
        "workload_extension"
      ],
      "properties": {
        "profiler": { "const": "samply" },
        "rate_hz": { "const": 1000 },
        "reuse_threads": { "const": false },
        "minimum_workload_seconds": { "type": "integer", "minimum": 5 },
        "observed_wall_seconds": { "type": ["number", "null"], "minimum": 0 },
        "workload_extension": { "const": "loop-selected-benchmark" }
      }
    },
    "samples": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "unknown_leaf_count", "unknown_leaf_ratio"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "unknown_leaf_count": { "type": "integer", "minimum": 0 },
        "unknown_leaf_ratio": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "symbols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "godot"],
      "properties": {
        "rust": { "type": "boolean" },
        "godot": { "type": "boolean" }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "samples", "percent"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "samples": { "type": "integer", "minimum": 1 },
        "percent": { "type": "number", "minimum": 0 }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message", "metadata"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "present", "size_bytes", "metadata"],
      "properties": {
        "kind": {
          "enum": [
            "profile",
            "symbols",
            "folded-stacks",
            "flamegraph",
            "samply-log",
            "godot-log"
          ]
        },
        "path": { "type": "string", "minLength": 1 },
        "present": { "type": "boolean" },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
